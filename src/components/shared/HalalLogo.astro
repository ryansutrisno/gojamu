---
// Halal Indonesia Logo Component
// Based on: https://commons.wikimedia.org/wiki/File:Halal_Indonesia.svg
interface Props {
  size?: number;
  color?: string;
}

const { size = 16, color = 'currentColor' } = Astro.props;
---

<svg 
  width={size} 
  height={size} 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg"
  class="halal-logo"
>
  <!-- Crescent moon -->
  <path
    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
    fill={color}
    opacity="0.3"
  />
  <!-- Star -->
  <path
    d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
    fill={color}
    transform="scale(0.6) translate(8, 8)"
  />
</svg>

<style>
  .halal-logo {
    display: inline-block;
    vertical-align: middle;
  }
  .halal-logo svg {
    display: block;
  }
</style>
