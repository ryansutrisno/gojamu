const style = `width:${size}px;height:${size}px;color:${color}`;
---

<span class="icon-wrap" style={style} set:html={useFallback ? (icons[name] || '') : emoji} />

<style>
  .icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .icon-wrap svg {
    display: block;
  }
</style>