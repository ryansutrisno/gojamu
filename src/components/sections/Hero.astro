---
import Icon from '../shared/Icon.astro';

interface Props {
  waLink?: string;
  learnMoreLink?: string;
}

const {
  waLink = 'https://wa.me/6281225463341?text=Halo+GoJamu,+saya+ingin+tahu+lebih+lanjut+tentang+produk+herbal+Anda',
  learnMoreLink = '#produk',
} = Astro.props;
---

<section id="hero">
  <div class="hero-badge"><Icon name="leaf" size={14} /> 100% Herbal Alami · Tanpa Bahan Kimia</div>
  <h1 class="hero-title">
    Tubuh Sehat Dimulai dari<br />
    <em>Alam yang Terjaga</em>
  </h1>
  <p class="hero-sub">
    Produk jamu herbal GoJamu hadir dari bahan-bahan pilihan alam Nusantara — diformulasikan modern
    untuk kehidupan Anda yang lebih sehat setiap hari.
  </p>

  <div class="hero-products">
    <div class="prod-pill pill-green"><Icon name="leaf" emoji="🍃" size={16} /> Ko Gan Ti – Anti Kanker</div>
    <div class="prod-pill pill-blue"><Icon name="heart" emoji="💙" size={16} /> Nirlawa – Lambung Sehat</div>
    <div class="prod-pill pill-rose"><Icon name="flower" emoji="🌸" size={16} /> Mahakunir – Cantik Alami</div>
  </div>

  <div class="hero-cta-wrap">
    <a href={waLink} class="btn-primary btn-wa" target="_blank">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
        />
        <path
          d="M11.5 2C6.253 2 2 6.253 2 11.5c0 1.87.518 3.617 1.418 5.115L2 22l5.545-1.395A9.456 9.456 0 0 0 11.5 21C16.747 21 21 16.747 21 11.5S16.747 2 11.5 2zm0 17.25a7.72 7.72 0 0 1-3.938-1.079l-.282-.168-2.928.736.78-2.852-.184-.293A7.718 7.718 0 0 1 3.75 11.5C3.75 7.216 7.216 3.75 11.5 3.75S19.25 7.216 19.25 11.5 15.784 19.25 11.5 19.25z"
        />
      </svg>
      Chat WhatsApp Sekarang
    </a>
    <a href={learnMoreLink} class="btn-outline">
      Lihat Produk ↓
    </a>
  </div>

  <div class="trust-row">
    <div class="trust-item">
      <div class="trust-icon"><Icon name="check-circle" emoji="✅" size={20} /></div>
      <div>
        <strong>HALAL</strong><br />
        Tersertifikasi
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><Icon name="leaf" emoji="🌿" size={20} /></div>
      <div>
        <strong>100% Alami</strong><br />
        Tanpa Pengawet
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><Icon name="microscope" emoji="🔬" size={20} /></div>
      <div>
        <strong>Teruji Klinis</strong><br />
        BPOM Terdaftar
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><Icon name="truck" emoji="🚚" size={20} /></div>
      <div>
        <strong>Kirim Cepat</strong><br />
        Seluruh Indonesia
      </div>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 140px 5% 80px;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(82, 183, 136, 0.18) 0%, transparent 70%),
      linear-gradient(170deg, #f0f7f2 0%, var(--cream) 55%, #fdf3e3 100%);
    text-align: center;
    z-index: 1;
  }
  @media (max-width: 600px) {
    #hero {
      padding-top: 120px;
    }
  }

  /* Animated bokeh circles */
  #hero::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(82, 183, 136, 0.12) 0%, transparent 70%);
    top: -100px;
    left: -150px;
    animation: drift 12s ease-in-out infinite alternate;
  }
  #hero::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.1) 0%, transparent 70%);
    bottom: -80px;
    right: -80px;
    animation: drift 15s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(30px, 20px) scale(1.1);
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--herb);
    background: rgba(82, 183, 136, 0.12);
    border: 1px solid rgba(82, 183, 136, 0.3);
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 28px;
    animation: fadeUp 0.8s ease both;
  }
  .hero-badge::before {
    content: '🌿';
    font-size: 0.9rem;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--forest);
    margin-bottom: 12px;
    animation: fadeUp 0.8s 0.15s ease both;
  }
  .hero-title em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 36px;
    animation: fadeUp 0.8s 0.25s ease both;
  }

  /* Produk pills hero */
  .hero-products {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 44px;
    animation: fadeUp 0.8s 0.35s ease both;
  }
  .prod-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    border: 1.5px solid;
    cursor: default;
    transition: transform 0.2s;
  }
  .prod-pill:hover {
    transform: translateY(-2px);
  }
  .pill-green {
    background: rgba(26, 61, 43, 0.06);
    border-color: var(--herb);
    color: var(--forest);
  }
  .pill-blue {
    background: rgba(58, 134, 200, 0.07);
    border-color: var(--sky);
    color: #1b4e8a;
  }
  .pill-rose {
    background: rgba(232, 160, 176, 0.15);
    border-color: var(--rose-dk);
    color: #8b3a52;
  }

  .hero-cta-wrap {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeUp 0.8s 0.45s ease both;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 32px;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s;
    cursor: pointer;
    border: none;
  }
  .btn-wa {
    background: #25d366;
    color: #fff;
    box-shadow: 0 8px 28px rgba(37, 211, 102, 0.35);
  }
  .btn-wa:hover {
    background: #1db954;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.45);
  }
  .btn-outline {
    background: transparent;
    color: var(--forest);
    border: 1.5px solid var(--herb);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s;
    cursor: pointer;
    position: relative;
    z-index: 10;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .btn-outline:hover {
    background: var(--forest);
    color: var(--cream);
  }
  @media (max-width: 600px) {
    .btn-outline {
      padding: 12px 24px;
      font-size: 0.9rem;
    }
    .hero-cta-wrap {
      gap: 10px;
    }
  }

  /* Trust badges hero */
  .trust-row {
    margin-top: 52px;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeUp 0.8s 0.55s ease both;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .trust-item strong {
    color: var(--text-main);
  }
  .trust-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(82, 183, 136, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }
</style>
