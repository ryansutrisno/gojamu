---
import { products, type Product } from '../../data/products';
import Icon from '../shared/Icon.astro';
import HalalLogo from '../shared/HalalLogo.astro';

interface Props {
  waBaseLink?: string;
}

const { waBaseLink = 'https://wa.me/628XXXXXXXXXX' } = Astro.props;

function getWaLink(product: Product): string {
  return `${waBaseLink}?text=${encodeURIComponent(product.waMessage)}`;
}
---

<section id="produk">
  <div class="produk-header reveal">
    <p class="section-label">Solusi Herbal Kami</p>
    <h2 class="section-title">
      Pilih Produk<br />
      yang Tepat untuk <em>Anda</em>
    </h2>
    <div class="divider-leaf">🌿 ✦ 🌿</div>
    <p class="section-desc" style="margin:0 auto;">
      Setiap produk GoJamu diformulasikan khusus dari bahan herbal pilihan, tanpa pengawet buatan, aman
      dikonsumsi setiap hari.
    </p>
  </div>

  <div class="produk-grid">
    {products.map((product, index) => (
      <div class={`produk-card ${product.cardClass} reveal`} style={`transition-delay:${0.1 + index * 0.1}s`}>
        <div class="card-img-wrap">
          <img src={product.image.src} alt={product.name} class="card-image" loading="lazy" />
          <div class="card-badge-new">BARU!</div>
          <div class="card-badge-halal">
            <HalalLogo size={12} />
          </div>
        </div>
        <div class="card-body">
          <span class="card-tag">{product.tag}</span>
          <div class="card-name">{product.name}</div>
          <div class="card-sub">{product.subtitle}</div>
          <p class="card-claim">{product.claim}</p>
          <ul class="card-benefits">
            {product.benefits.map((benefit) => (
              <li>
                <span class="benefit-dot"><Icon name="check" emoji="✓" size={12} /></span>
                {benefit}
              </li>
            ))}
          </ul>
          <a href={getWaLink(product)} class="card-cta" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
              />
              <path
                d="M11.5 2C6.253 2 2 6.253 2 11.5c0 1.87.518 3.617 1.418 5.115L2 22l5.545-1.395A9.456 9.456 0 0 0 11.5 21C16.747 21 21 16.747 21 11.5S16.747 2 11.5 2zm0 17.25a7.72 7.72 0 0 1-3.938-1.079l-.282-.168-2.928.736.78-2.852-.184-.293A7.718 7.718 0 0 1 3.75 11.5C3.75 7.216 7.216 3.75 11.5 3.75S19.25 7.216 19.25 11.5 15.784 19.25 11.5 19.25z"
              />
            </svg>
            Tanya Harga via WA
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  #produk {
    padding: 96px 5%;
    background: var(--warm);
  }
  .produk-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .produk-header .section-desc {
    margin: 0 auto;
  }

  .produk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .produk-card {
    border-radius: 24px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 4px 24px rgba(26, 61, 43, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
  }
  .produk-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(26, 61, 43, 0.14);
  }

  /* Warna aksen per produk */
  .card-koganti {
    --card-accent: var(--herb);
    --card-accent-lt: #e0f2ea;
    --card-text: var(--forest);
  }
  .card-nirlawa {
    --card-accent: var(--sky);
    --card-accent-lt: var(--sky-lt);
    --card-text: #1a3a6b;
  }
  .card-mahakunir {
    --card-accent: var(--rose-dk);
    --card-accent-lt: #fde8ee;
    --card-text: #7a2b42;
  }

  .card-img-wrap {
    position: relative;
    height: 220px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
  }
  .card-koganti .card-img-wrap {
    background: linear-gradient(135deg, #1a3d2b 0%, #2d6a4f 100%);
  }
  .card-nirlawa .card-img-wrap {
    background: linear-gradient(135deg, #d0e8f8 0%, #9ecfed 100%);
  }
  .card-mahakunir .card-img-wrap {
    background: linear-gradient(135deg, #fde8ee 0%, #f5c6d6 100%);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .produk-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-badge-new {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--gold);
    color: var(--forest);
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    letter-spacing: 0.05em;
  }
  .card-badge-halal {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50px;
    padding: 4px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .card-body {
    padding: 28px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-tag {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--card-text);
    background: var(--card-accent-lt);
    padding: 4px 12px;
    border-radius: 50px;
    margin-bottom: 12px;
  }
  .card-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 4px;
  }
  .card-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .card-claim {
    font-size: 0.95rem;
    color: var(--text-main);
    line-height: 1.65;
    margin-bottom: 20px;
    font-style: italic;
    padding-left: 14px;
    border-left: 3px solid var(--card-accent);
  }
  .card-benefits {
    list-style: none;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .benefit-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--card-accent-lt);
    color: var(--card-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .card-cta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 20px;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s;
    background: var(--card-accent);
    color: var(--white);
  }
  .card-cta:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }
</style>
