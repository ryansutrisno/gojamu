---
import Icon from '../shared/Icon.astro';
import { buildWALink } from '../../utils/wa';

interface Props {
  waLink?: string;
}

const {
  waLink = buildWALink('Halo GoJamu! Saya mau konsultasi produk herbal yang cocok untuk saya'),
} = Astro.props;
---

<section id="cta">
  <p class="cta-eyebrow reveal">Mulai Perjalanan Sehat Anda</p>
  <h2 class="cta-title reveal">
    Siap Hidup Lebih Sehat<br />
    dengan <em>Herbal Alami?</em>
  </h2>
  <p class="cta-desc reveal">
    Konsultasikan kebutuhan kesehatan Anda secara gratis bersama tim GoJamu. Kami siap membantu Anda
    memilih produk yang paling tepat.
  </p>
<div class="cta-buttons reveal">
    <a href={waLink} class="btn-wa-lg" target="_blank">
      <svg viewBox="0 0 24 24">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
        />
        <path
          d="M11.5 2C6.253 2 2 6.253 2 11.5c0 1.87.518 3.617 1.418 5.115L2 22l5.545-1.395A9.456 9.456 0 0 0 11.5 21C16.747 21 21 16.747 21 11.5S16.747 2 11.5 2zm0 17.25a7.72 7.72 0 0 1-3.938-1.079l-.282-.168-2.928.736.78-2.852-.184-.293A7.718 7.718 0 0 1 3.75 11.5C3.75 7.216 7.216 3.75 11.5 3.75S19.25 7.216 19.25 11.5 15.784 19.25 11.5 19.25z"
        />
      </svg>
      Konsultasi GRATIS via WhatsApp
    </a>
  </div>
  <p class="wa-hint reveal"><Icon name="chat-bubble" emoji="💬" size={16} /> Respon cepat · Tidak ada paksaan beli · Konsultasi ramah &amp; personal</p>
</section>

<style>
  #cta {
    padding: 96px 5%;
    background: var(--forest);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  #cta::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    top: -150px;
    right: -100px;
  }
  #cta::after {
    content: '';
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(82, 183, 136, 0.12) 0%, transparent 70%);
    bottom: -80px;
    left: -60px;
  }
  .cta-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-lt);
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
  }
  .cta-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }
  .cta-title em {
    font-style: italic;
    color: var(--gold-lt);
  }
  .cta-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto 40px;
    position: relative;
    z-index: 1;
  }
  .cta-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .btn-wa-lg {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 36px;
    border-radius: 50px;
    background: #25d366;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s;
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.4);
  }
  .btn-wa-lg:hover {
    background: #1db954;
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(37, 211, 102, 0.5);
  }
  .btn-wa-lg svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .wa-hint {
    margin-top: 20px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    position: relative;
    z-index: 1;
  }
</style>
