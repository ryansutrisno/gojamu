---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import StickyWA from '../components/layout/StickyWA.astro';
import Hero from '../components/sections/Hero.astro';
import PainPoints from '../components/sections/PainPoints.astro';
import ProductCards from '../components/sections/ProductCards.astro';
import Keunggulan from '../components/sections/Keunggulan.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import CTA from '../components/sections/CTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import ScrollReveal from '../components/shared/ScrollReveal.astro';

const canonicalURL = new URL(
  Astro.url?.pathname || '/',
  'https://gojamu.vercel.app',
).href;
---

<BaseLayout
  title="GoJamu – Herbal Alami untuk Hidup Sehat"
  description="Produk jamu herbal GoJamu hadir dari bahan-bahan pilihan alam Nusantara — diformulasikan modern untuk kehidupan Anda yang lebih sehat setiap hari. 100% alami, HALAL, PIRT terdaftar."
  image="/og-image.webp"
  canonicalURL={canonicalURL}
>
  <Navbar />
  <Hero />
  <PainPoints />
  <ProductCards />
  <Keunggulan />
  <Testimonials />
  <CTA />
  <FAQ />
  <Footer />
  <StickyWA />
  <ScrollReveal />
</BaseLayout>
